{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetManager",
  "version": "0.10.0",
  "identifier": "com.assetmanager.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm --prefix app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AssetManager",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
