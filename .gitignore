# ===== 构建产物（可再生，当前合计约 5.1 GB）=====
target/
**/target/
app/dist/
app/node_modules/
node_modules/

# Tauri 生成物（capabilities schema 等，每次构建重生成）
src-tauri/gen/

# ===== 本地开发/调试，不进版本库 =====
*.log
_tmp/
probes/
# 卸载重装前的数据备份（本地用，别进库）
_backup-*/
.shots/
*.tmp
# 自测截图（tools/e2e_*.py 生成的 _board1.png / _snip*.png 之类）
tools/_*.png
tools/_*.jpg

# ===== 运行时数据：绝不能进库 =====
# 索引库 / 缩略图缓存 / ops 日志
*.db
*.db-wal
*.db-shm
cache/
thumbs/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
desktop.ini
Thumbs.db
.DS_Store

# ===== 内部过程文档：只在本机维护，不进公库 =====
# 理由（owner 2026-11-17）：这些是开发账本与方案稿，公开仓库只放 README / 源码 / 截图。
/AssetManager-*.md
/AssetManager-*.html
/WORKLOG.md
/标签系统方案.md
/UI待定问题清单.md
/docs/AssetManager-*.md
# UI 设计稿是实现参考稿，不是交付文档，不进公库
/docs/*设计稿*.html
# 历史版本截图留在本地（发布用的那张固定叫 docs/screenshot.png）
/docs/shots-*.png

# ===== 内部留痕 / 测试执行报告（不进公库，与 WORKLOG 同级）=====
/.workbuddy/
/docs/reports/

tools/_*.bmp

# ===== 本机临时脚本 / 缓存（qa 期的探针，不进公库）=====
qa-tmp/
app/qa-tmp/
__pycache__/
*.pyc

# ===== 图标设计工作区（162 MB / 1900+ 过程图，不进公库）=====
/design/icons-am/
/design/

